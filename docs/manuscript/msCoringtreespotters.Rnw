)

print(xtable(combined,
             caption = "Summary output of each parameter from the previous year model (Equation \\ref{eq:prvsYrMdl}) using ring width (log(mm)) as the response variable. We report estimates as mean and 90\\% uncertainty intervals (in square brackets). see `Data analyses' section in Methods for more details",
             label = "tab:tab_PrvsYr"),
      include.rownames = FALSE, sanitize.text.function = identity, caption.placement = "top")
@

<<Table SOS on EOS, results='asis', echo = FALSE>>=
options(digits = 2)

a_df2      <- read.csv("/Users/christophe_rouleau-desrochers/github/coringtreespotters/analyses/output/SOSonEOS_param_a.csv")
sigma_df2  <- read.csv("/Users/christophe_rouleau-desrochers/github/coringtreespotters/analyses/output/SOSonEOS_param_sigma.csv")
bspp_df2   <- read.csv("/Users/christophe_rouleau-desrochers/github/coringtreespotters/analyses/output/SOSonEOS_param_bspp.csv")
aspp_df2   <- read.csv("/Users/christophe_rouleau-desrochers/github/coringtreespotters/analyses/output/SOSonEOS_param_aspp.csv")
ayear_df2  <- read.csv("/Users/christophe_rouleau-desrochers/github/coringtreespotters/analyses/output/SOSonEOS_param_ayear.csv")

bspp_df2$spp_name  <- empts$latbi[match(bspp_df2$spp, empts$spp_num)]
bspp_df2Yr$spp_name  <- empts$latbi[match(bspp_df2Yr$spp, empts$spp_num)]
aspp_df2$spp_name  <- empts$latbi[match(aspp_df2$spp, empts$spp_num)]
ayear_df2$year_name <- empts$year[match(ayear_df2$year, empts$year_num)]

# Reorder years
ayear_df2 <- ayear_df2[order(ayear_df2$year_name),]

fmt <- function(df) sprintf("%.2f [%.2f, %.2f]", df$mean, df$p5, df$p95)

param_labels <- c(
  "$\\alpha$",
  "$\\sigma_{\\alpha_{treeid}}$", "$\\sigma_{y}$",
  paste0("$\\beta_{\\text{species}_{", bspp_df2$spp_name,   "}}$"),
  # paste0("$\\alpha_{\\text{year}_{",   ayear_df2$year_name, "}}$"),
  paste0("$\\alpha_{\\text{species}_{",    aspp_df2$spp_name,   "}}$")
)

combined <- data.frame(
  "Parameter" = param_labels,
  "Estimate" = c(fmt(a_df2), fmt(sigma_df2), fmt(bspp_df2), fmt(aspp_df2)),
                 # fmt(ayear_df2)),
  check.names = FALSE
)

print(xtable(combined,
             caption = "Summary output of each parameter from the model on the effect of SOS (days) on EOS (days; Equation \\ref{eq:SOSonEOSMdl}). We report estimates as mean and 90\\% uncertainty intervals (in square brackets). see `Data analyses' section in Methods for more details",
             label = "tab:tab_SOSonEOS"),
      include.rownames = FALSE, sanitize.text.function = identity, caption.placement = "top")
@

