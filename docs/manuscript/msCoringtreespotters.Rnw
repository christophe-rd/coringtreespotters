    "Pignut hickory (\\textit{Carya glabra})",
    "Shagbark hickory (\\textit{Carya ovata})",
    "River birch (\\textit{Betula nigra})",
    "Yellow birch (\\textit{Betula alleghaniensis})",
    "Sugar maple (\\textit{Acer saccharum})",
    "Red maple (\\textit{Acer rubrum})",
    "Yellow buckeye (\\textit{Aesculus flava})"
  ),
  LifeHistory = c(
    "Fast",
    "Fast",
    "Moderate",
    "Slow",
    "Slow",
    "Moderate",
    "Fast",
    "Moderate",
    "Slow",
    "Moderate",
    "Moderate"
  ),
  WoodAnatomy = c(
    "Diffuse-porous",
    "Diffuse-porous",
    "Ring-porous",
    "Ring-porous",
    "Ring-porous",
    "Ring-porous",
    "Diffuse-porous",
    "Diffuse-porous",
    "Diffuse-porous",
    "Diffuse-porous",
    "Diffuse-porous"
  ),
    n = c(
    countspp["T. americana"],
    countspp["P. deltoides"],
    countspp["Q. rubra"],
    countspp["Q. alba"],
    countspp["C. glabra"],
    countspp["C. ovata"],
    countspp["B. nigra"],
    countspp["B. alleghaniensis"],
